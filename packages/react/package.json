{
  "name": "@mdxstudio/react",
  "version": "0.2.9",
  "type": "module",
  "description": "MdxRenderer and the built-in MDX components: callouts, cards, stats, tabs, steps and the rest.",
  "keywords": [
    "mdx",
    "markdown",
    "react",
    "renderer",
    "mdx-components",
    "syntax-highlighting",
    "documentation"
  ],
  "license": "MIT",
  "author": "Suraj Donthi",
  "homepage": "https://github.com/SurajDonthi/mdx-preview/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurajDonthi/mdx-preview.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/SurajDonthi/mdx-preview/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^0.546.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6"
  },
  "peerDependencies": {
    "@mdxstudio/core": "^0.2.9",
    "react": "^19.0.0"
  }
}
