    "./protocol": "./src/protocol.ts",
    "./vite": "./src/build/vitePlugin.ts",
    "./build": "./src/build/bundleGuest.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@mdxkit/core": "*",
    "@mdxkit/react": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
