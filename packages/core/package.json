{
  "name": "@mdxstudio/core",
  "version": "0.2.2",
  "type": "module",
  "description": "Shared types, render context, MDX parsing and the component registry for mdxstudio.",
  "keywords": [
    "mdx",
    "markdown",
    "remark",
    "mdast",
    "hast",
    "frontmatter",
    "ast",
    "react"
  ],
  "license": "MIT",
  "author": "Suraj Donthi",
  "homepage": "https://github.com/SurajDonthi/mdx-preview/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurajDonthi/mdx-preview.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/SurajDonthi/mdx-preview/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "//dependencies": "`@types/hast` is a runtime dependency, not a dev one: `MdxDocumentAst` exposes a hast `Root`, so a consumer's typechecker has to be able to resolve it.",
  "dependencies": {
    "@types/hast": "^3.0.5",
    "estree-util-build-jsx": "^3.0.1",
    "estree-util-to-js": "^2.0.0",
    "js-yaml": "^5.2.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@types/mdast": "^4.0.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
