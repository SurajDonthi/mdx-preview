{
  "name": "@mdxstudio/pdf",
  "version": "0.3.0",
  "type": "module",
  "description": "DOM-to-A4-PDF exporter for rendered MDX documents.",
  "keywords": [
    "mdx",
    "pdf",
    "export",
    "jspdf",
    "html2canvas",
    "print",
    "a4"
  ],
  "license": "MIT",
  "author": "Suraj Donthi",
  "homepage": "https://github.com/SurajDonthi/mdx-preview/tree/main/packages/pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurajDonthi/mdx-preview.git",
    "directory": "packages/pdf"
  },
  "bugs": {
    "url": "https://github.com/SurajDonthi/mdx-preview/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  }
}
