node_modules/
# Anchored: unanchored these match any directory of that name at any depth, which
# silently hid packages/sandbox/src/build/ - real source - from the repository.
/build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# browser automation scratch output
.playwright-cli/
*.stackdump

# Firebase project config - supplied via .env, see .env.example
firebase-applet-config.json

# Generated copy of skills/mdx-docs, made by the agent-skill build and by its
# prepack so the published tarball carries it. The repository-root skills/
# directory is the single source of truth; committing a second copy would let
# the two drift.
/packages/agent-skill/skill/

# Packaged extensions. Built on demand by `vsce package`; the marketplace is
# the distribution channel, not the repository.
*.vsix

# Cygwin/MSYS crash dumps, which land in whatever directory was current.
*.stackdump
